{
  "manifest_version": 3,
  "name": "Contributor Stats for Cavan Images",
  "short_name": "Cavan Stats",
  "version": "1.0.0",
  "description": "Sales statistics for Cavan Images contributors: earnings by photo, shoot and month. Not affiliated with Cavan Images.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Contributor Stats for Cavan Images",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://www.cavanimages.com/*"]
}
